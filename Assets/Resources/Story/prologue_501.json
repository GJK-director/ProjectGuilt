    { "nodeId": "d014", "nodeType": "Dialogue", "nextNodeId": "d015", "dialogue": { "text": "没人回应。" } },
    { "nodeId": "d015", "nodeType": "Dialogue", "nextNodeId": "d016", "dialogue": { "text": "楼道里的臭味已经够重了。" } },
    { "nodeId": "d016", "nodeType": "Dialogue", "nextNodeId": "d017", "dialogue": { "text": "但门后还有别的味道。" } },
    { "nodeId": "d017", "nodeType": "Dialogue", "nextNodeId": "d018", "dialogue": { "text": "......血。" } },
    { "nodeId": "d018", "nodeType": "Dialogue", "nextNodeId": "d019", "dialogue": { "text": "看来真出事了。" } },
    { "nodeId": "d019", "nodeType": "Dialogue", "nextNodeId": "d020", "dialogue": { "text": "试了下门把手。" } },
    { "nodeId": "d020", "nodeType": "Dialogue", "nextNodeId": "bg_door_open", "dialogue": { "text": "......没锁。" } },

    { "nodeId": "bg_door_open", "nodeType": "ChangeBackground", "nextNodeId": "door_open_click", "background": { "backgroundId": "corridor_door_open", "fadeSeconds": 0.45 } },

    { "nodeId": "d023", "nodeType": "Dialogue", "nextNodeId": "d024", "dialogue": { "text": "不知道哪儿传来的水滴声。" } },
    { "nodeId": "d024", "nodeType": "Dialogue", "nextNodeId": "d025", "dialogue": { "text": "一下||又一下。" } },
    { "nodeId": "d025", "nodeType": "Dialogue", "nextNodeId": "d026", "dialogue": { "text": "听着有点发毛。" } },
    { "nodeId": "d026", "nodeType": "Dialogue", "nextNodeId": "d027", "dialogue": { "text": "屋子深处，好像有光。" } },
    { "nodeId": "d027", "nodeType": "Dialogue", "nextNodeId": "bg_tv_wide", "dialogue": { "text": "......" } },


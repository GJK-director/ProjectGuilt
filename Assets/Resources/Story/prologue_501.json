    { "nodeId": "d007", "nodeType": "Dialogue", "nextNodeId": "d008", "dialogue": { "text": "12栋501......" } },
    { "nodeId": "d008", "nodeType": "Dialogue", "nextNodeId": "d009", "dialogue": { "text": "没错了。" } },
    { "nodeId": "d009", "nodeType": "Dialogue", "nextNodeId": "d010", "dialogue": { "text": "住户，男，34岁。所属公司反馈：连续旷工多日，多次联系无回应，疑似变异。" } },
    { "nodeId": "d010", "nodeType": "Dialogue", "nextNodeId": "d011", "dialogue": { "text": "确认住户情况并提交报告，若确认变异，进行清洁。" } },
    { "nodeId": "d011", "nodeType": "Dialogue", "nextNodeId": "d012", "dialogue": { "text": "风险评估：低。" } },
    { "nodeId": "d012", "nodeType": "Dialogue", "nextNodeId": "bg_door_return", "dialogue": { "text": "......｜｜先敲门看看吧。" } },


    { "nodeId": "d003", "nodeType": "Dialogue", "nextNodeId": "d004", "dialogue": { "text": "典型的老旧小区。" } },
    { "nodeId": "d004", "nodeType": "Dialogue", "nextNodeId": "d005", "dialogue": { "text": "倒也没什么好抱怨的。" } },
    { "nodeId": "d005", "nodeType": "Dialogue", "nextNodeId": "bg_door_closed", "dialogue": { "text": "反倒有点熟悉" } },

    { "nodeId": "bg_door_closed", "nodeType": "ChangeBackground", "nextNodeId": "d006", "background": { "backgroundId": "corridor_door_closed", "fadeSeconds": 1.6 } },
    { "nodeId": "d006", "nodeType": "Dialogue", "nextNodeId": "bg_phone_off", "dialogue": { "text": "应该就是这家了。" } },


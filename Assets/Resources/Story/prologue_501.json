  "nodes": [
    { "nodeId": "bg_black_start", "nodeType": "ChangeBackground", "nextNodeId": "d001", "background": { "backgroundId": "black", "fadeSeconds": 0.0 } },
    { "nodeId": "d001", "nodeType": "Dialogue", "nextNodeId": "d002", "dialogue": { "text": "昏暗的走廊。" } },
    { "nodeId": "d002", "nodeType": "Dialogue", "nextNodeId": "d003", "dialogue": { "text": "灰尘、垃圾，还有一股不知道从哪儿飘来的腐臭味。" } },
    { "nodeId": "d003", "nodeType": "Dialogue", "nextNodeId": "d004", "dialogue": { "text": "典型的老旧小区。" } },
    { "nodeId": "d004", "nodeType": "Dialogue", "nextNodeId": "d005", "dialogue": { "text": "倒也不是抱怨。" } },
    { "nodeId": "d005", "nodeType": "Dialogue", "nextNodeId": "d006", "dialogue": { "text": "相反，这地方还有点熟悉。" } },
    { "nodeId": "d006", "nodeType": "Dialogue", "nextNodeId": "bg_door_closed", "dialogue": { "text": "可能这就是属于我们老鼠的本能吧。" } },

    { "nodeId": "bg_door_closed", "nodeType": "ChangeBackground", "nextNodeId": "d007", "background": { "backgroundId": "corridor_door_closed", "fadeSeconds": 1.6 } },
    { "nodeId": "d007", "nodeType": "Dialogue", "nextNodeId": "bg_phone_off", "dialogue": { "text": "应该就是这家了。" } },

    { "nodeId": "bg_phone_off", "nodeType": "ChangeBackground", "nextNodeId": "phone_off_hold", "background": { "backgroundId": "phone_off", "fadeSeconds": 0.35 } },
    { "nodeId": "phone_off_hold", "nodeType": "Wait", "nextNodeId": "bg_phone_on", "wait": { "seconds": 0.55, "skippable": true } },
    { "nodeId": "bg_phone_on", "nodeType": "ChangeBackground", "nextNodeId": "d008", "background": { "backgroundId": "phone_on", "fadeSeconds": 0.16 } },
    { "nodeId": "d008", "nodeType": "Dialogue", "nextNodeId": "d009", "dialogue": { "text": "12栋501……" } },
    { "nodeId": "d009", "nodeType": "Dialogue", "nextNodeId": "d010", "dialogue": { "text": "没错了。" } },
    { "nodeId": "d010", "nodeType": "Dialogue", "nextNodeId": "d011", "dialogue": { "text": "住户男，34岁。" } },
    { "nodeId": "d011", "nodeType": "Dialogue", "nextNodeId": "d012", "dialogue": { "text": "接到公司反馈，男子旷工多日，数次联系均无所响应，怀疑其存在变异可能。" } },
    { "nodeId": "d012", "nodeType": "Dialogue", "nextNodeId": "d013", "dialogue": { "text": "需要检查男子情况并提交报告。若男子已经变异，则进行清洁。" } },
    { "nodeId": "d013", "nodeType": "Dialogue", "nextNodeId": "d014", "dialogue": { "text": "风险评估：低。" } },
    { "nodeId": "d014", "nodeType": "Dialogue", "nextNodeId": "bg_door_return", "dialogue": { "text": "先敲门看看吧。" } },

    { "nodeId": "bg_door_return", "nodeType": "ChangeBackground", "nextNodeId": "sfx_knock", "background": { "backgroundId": "corridor_door_closed", "fadeSeconds": 0.35 } },
    { "nodeId": "sfx_knock", "nodeType": "PlaySfx", "nextNodeId": "d015", "parameters": { "sfxId": "door_knock", "waitSeconds": "0.9" } },
    { "nodeId": "d015", "nodeType": "Dialogue", "nextNodeId": "d016", "dialogue": { "text": "没人回应。" } },
    { "nodeId": "d016", "nodeType": "Dialogue", "nextNodeId": "d017", "dialogue": { "text": "楼道里的臭味已经够重了。" } },
    { "nodeId": "d017", "nodeType": "Dialogue", "nextNodeId": "d018", "dialogue": { "text": "可门后那股血味，我还是闻得出来。" } },
    { "nodeId": "d018", "nodeType": "Dialogue", "nextNodeId": "d019", "dialogue": { "text": "……看来真出事了。" } },
    { "nodeId": "d019", "nodeType": "Dialogue", "nextNodeId": "d020", "dialogue": { "text": "我压了压门把手。" } },
    { "nodeId": "d020", "nodeType": "Dialogue", "nextNodeId": "bg_door_open", "dialogue": { "text": "……没锁。" } },

    { "nodeId": "bg_door_open", "nodeType": "ChangeBackground", "nextNodeId": "door_open_hold", "background": { "backgroundId": "corridor_door_open", "fadeSeconds": 0.45 } },
    { "nodeId": "door_open_hold", "nodeType": "Wait", "nextNodeId": "bg_room_black", "wait": { "seconds": 0.8, "skippable": true } },
    { "nodeId": "bg_room_black", "nodeType": "ChangeBackground", "nextNodeId": "d021", "background": { "backgroundId": "black", "fadeSeconds": 0.3 } },
    { "nodeId": "d021", "nodeType": "Dialogue", "nextNodeId": "d022", "dialogue": { "text": "比想象中还黑。" } },
    { "nodeId": "d022", "nodeType": "Dialogue", "nextNodeId": "d023", "dialogue": { "text": "借着楼道窗透进来的光，勉强能看清屋内的轮廓。" } },
    { "nodeId": "d023", "nodeType": "Dialogue", "nextNodeId": "d024", "dialogue": { "text": "不知道哪儿传来的水滴声。" } },
    { "nodeId": "d024", "nodeType": "Dialogue", "nextNodeId": "d025", "dialogue": { "text": "一下||又一下。" } },
    { "nodeId": "d025", "nodeType": "Dialogue", "nextNodeId": "d026", "dialogue": { "text": "听得人有点发毛。" } },
    { "nodeId": "d026", "nodeType": "Dialogue", "nextNodeId": "d027", "dialogue": { "text": "屋子深处，好像有光。" } },
    { "nodeId": "d027", "nodeType": "Dialogue", "nextNodeId": "bg_tv_wide", "dialogue": { "text": "我朝那边走去。" } },

    { "nodeId": "bg_tv_wide", "nodeType": "ChangeBackground", "nextNodeId": "d028", "background": { "backgroundId": "tv_viewer_wide", "fadeSeconds": 1.0 } },
    { "nodeId": "d028", "nodeType": "Dialogue", "nextNodeId": "d029", "dialogue": { "text": "客厅里亮着电视。" } },
    { "nodeId": "d029", "nodeType": "Dialogue", "nextNodeId": "bg_tv_variant", "dialogue": { "text": "雪花屏……||？" } },
    { "nodeId": "bg_tv_variant", "nodeType": "ChangeBackground", "nextNodeId": "d030", "background": { "backgroundId": "tv_viewer_variant", "fadeSeconds": 0.18 } },
    { "nodeId": "d030", "nodeType": "Dialogue", "nextNodeId": "d031", "dialogue": { "text": "电视前坐着个人……||至少，看起来还是个人。" } },
    { "nodeId": "d031", "nodeType": "Dialogue", "nextNodeId": "d032", "dialogue": { "text": "“你好？”" } },
    { "nodeId": "d032", "nodeType": "Dialogue", "nextNodeId": "bg_monster_turn", "dialogue": { "text": "…………" } },

